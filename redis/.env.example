# PostgreSQL - Aiven
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# JWT - gerar localmente com: openssl rand -base64 32
JWT_SECRET=
# Access token curto (30 min); o app renova com o refresh token
JWT_EXPIRATION_MS=1800000
# Refresh token (30 dias)
JWT_REFRESH_EXPIRATION_MS=2592000000

# Pedido de entrada na cozinha: tempo que um pedido pendente espera antes de expirar
KITCHEN_ACCESS_REQUEST_TTL=7d
# Consultas por hora, por usuário, na busca de cozinha por código
KITCHEN_CODE_LOOKUP_MAX_PER_HOUR=10

# Descoberta de cozinhas: buscas por minuto, por usuário
KITCHEN_DISCOVERY_MAX_PER_MINUTE=30
# Geocodificação (Nominatim) das cozinhas sem coordenadas; o User-Agent deve identificar o app
GEOCODING_ENABLED=true
GEOCODING_USER_AGENT=Inventra/1.0 (contato@exemplo.com)

# Dias antes do vencimento em que o job diário gera o alerta EXPIRING
ALERTS_EXPIRING_DAYS=3

# Login com Google: chave da conta de serviço do Firebase (JSON puro ou em base64). Vazio = login Google desligado
FIREBASE_CREDENTIALS_JSON=

# Log de SQL do Hibernate (desligado por padrão; true só em dev)
JPA_SHOW_SQL=false

# Swagger UI / OpenAPI (false para esconder em produção)
SWAGGER_ENABLED=true

# Job diário que marca lotes vencidos como EXPIRED
BATCH_EXPIRATION_JOB_ENABLED=true

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Cloudinary - dashboard > Settings > API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis
REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=
REDIS_SSL=true

# Fila de cadastro por código de barras (INV2-25)
REDIS_PRODUCT_QUEUE_CONSUMER_ENABLED=true
REDIS_PRODUCT_QUEUE_KEY_PREFIX=inventra:product-registration

# Ranking de validade por cozinha (INV2-26)
REDIS_RANKING_KEY_PREFIX=inventra:ranking:expiration
REDIS_RANKING_TTL_SECONDS=60
